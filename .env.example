# ── Domain Hunter 環境變數設定 ──

# (選填) OpenPageRank API Key — 免費申請: https://www.domcop.com/openpagerank/
OPENPAGERANK_API_KEY=

# (選填) Google Safe Browsing API Key — https://console.cloud.google.com/
GOOGLE_SAFE_BROWSING_API_KEY=

# (選填) VirusTotal API Key — https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# (選填) Ahrefs API Key — 若有付費帳號
AHREFS_API_KEY=

# ── ExpiredDomains.net 自動爬取 ──
# 登入 expireddomains.net → 瀏覽器 DevTools → Cookies → 複製 PHPSESSID
EXPIRED_DOMAINS_PHPSESSID=

# ── 分析參數 ──

# Wayback Machine 最多抓取快照數（預設 10）
WAYBACK_MAX_SNAPSHOTS=10

# 並行分析的 worker 數量（預設 5）
MAX_WORKERS=5

# 每次 HTTP 請求的超時秒數（預設 30）
REQUEST_TIMEOUT=30
